# =============================================================
# AI Coal Mine Governance System — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# =============================================================

# Database
POSTGRES_USER=coalmine
POSTGRES_PASSWORD=coalmine_secret_change_me
POSTGRES_DB=coalmine_db

# Backend
SECRET_KEY=change_this_to_a_very_long_random_secret_key_in_production
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Provider (OpenAI-compatible)
# Leave blank to use DEMO MODE fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# OCR
PADDLEOCR_ENABLED=false
TESSERACT_ENABLED=true

# Demo Mode
DEMO_MODE=true
SEED_DATABASE=true
